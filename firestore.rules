rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      // Public read (app only ever reads exteriorPOIs/floors/rooms client-side),
      // no client writes — all data entry goes through the Firebase MCP/Console
      // as an authenticated project owner, which bypasses these rules entirely.
      allow read: if true;
      allow write: if false;
    }
  }
}
